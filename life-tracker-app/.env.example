# Database
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB=lifetracker

# Backend
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Movie details (posters, plot, runtime, genres) from TMDB. Free key: https://www.themoviedb.org/settings/api
# Either the "API Key" or the "API Read Access Token" works. Leave empty to turn movie details off.
TMDB_API_KEY=
