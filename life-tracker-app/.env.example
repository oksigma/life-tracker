# Database
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB=lifetracker

# Backend
CORS_ORIGINS=["http://localhost:3000"]

# Frontend: the browser calls /api on the frontend, which forwards to the backend (next.config.mjs).
# Defaults to http://localhost:8000. On Vercel, set BACKEND_URL on the frontend project.
# BACKEND_URL=http://localhost:8000

# App password (spec 0006). Leave empty locally for no login; always set it when deployed.
APP_PASSWORD=
# Long random value for signing session cookies (e.g. `openssl rand -hex 32`). Set when deployed.
SESSION_SECRET=

# Movie details (posters, plot, runtime, genres) from TMDB. Free key: https://www.themoviedb.org/settings/api
# Either the "API Key" or the "API Read Access Token" works. Leave empty to turn movie details off.
TMDB_API_KEY=
